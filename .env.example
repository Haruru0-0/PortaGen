# Copy this to .env (used by the drizzle `db:*` commands) and .env.local (used by `yarn dev`) and fill it in.
# Never commit real values.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The public anon / publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Postgres connection string (Supabase: Project Settings > Database > Connection string) ---
# Used by drizzle-kit (db:generate, db:push, db:migrate) and the app's database access
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- App address ---
# http://localhost:3000 locally, your Vercel address in production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Encryption for stored third-party tokens (Spotify) ---
# Any long random string, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it makes every stored token unreadable, so people would have to reconnect.
ENCRYPTION_KEY=

# --- UploadThing file storage (uploadthing.com > your app > API Keys) ---
# Used for wallpapers, icons, music and sounds. Create an app and copy its token here.
UPLOADTHING_TOKEN=

# --- Spotify integration (developer.spotify.com/dashboard) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Email for the portfolio contact form (any SMTP server; Gmail needs an app password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true for port 465, false for 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional. Sender and fallback recipient; both default to SMTP_USER
CONTACT_FROM=
CONTACT_TO=

# --- Public contact address shown on the privacy page (optional) ---
NEXT_PUBLIC_CONTACT_EMAIL=
